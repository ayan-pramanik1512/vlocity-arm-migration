          "hasDynamicHelp": true,
          "multiple": false,
          "type": "option"
        }
      },
      "hasDynamicHelp": true,
      "hiddenAliases": [],
      "id": "vlocity:inventory:catalog",
      "pluginAlias": "@vlocity/inventory-plugin",
      "pluginName": "@vlocity/inventory-plugin",
      "pluginType": "core",
      "strict": true,
      "summary": "Inventory Vlocity CMT catalogs in a sandbox",
      "enableJsonFlag": true,
      "isESM": true,
      "relativePath": [
        "lib",
        "commands",
        "vlocity",
        "inventory",
        "catalog.js"
      ]
    },
