{
  "name": "@vlocity/inventory-plugin",
  "version": "0.1.0",
  "description": "Salesforce CLI plugin to inventory Vlocity CMT metadata: catalog, products, pricing, OmniStudio, and custom Apex references",
  "author": "vlocity-team",
  "license": "MIT",
  "main": "lib/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayan-pramanik1512/vlocity-inventory.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bin": {
    "vlocity-inventory": "./bin/run.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf lib",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "test": "node --loader ts-node/esm --no-warnings node_modules/.bin/mocha \"test/**/*.test.ts\"",
    "dev": "ts-node --esm src/index.ts"
  },
  "dependencies": {
    "@oclif/core": "^4",
    "@salesforce/core": "^8",
    "@salesforce/sf-plugins-core": "^11",
    "chalk": "^5"
  },
  "devDependencies": {
    "@oclif/test": "^4",
    "@types/node": "^20",
    "oclif": "^4",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/bin",
    "/lib",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "salesforce",
    "vlocity",
    "cmt",
    "sfdx",
    "sf-plugin"
  ],
  "oclif": {
    "bin": "sf",
    "dirname": "vlocity-inventory",
    "commands": "./lib/commands",
    "plugins": [],
    "topicSeparator": " ",
    "topics": {
      "vlocity": {
        "description": "Vlocity CMT inventory and analysis tools"
      },
      "vlocity inventory": {
        "description": "Inventory Vlocity CMT metadata in a sandbox"
      }
    }
  }
}
